{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "jsx": "react-jsx",
    "types": [
      "jest",
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ],
    "module": "preserve", // Hoặc "es2022", "nodeNext", hoặc "preserve"

    "moduleResolution": "bundler", // Hoặc "nodeNext", "bundler" (nếu bạn muốn dùng 'bundler')

    "target": "es2020",

    "esModuleInterop": true
  },
  "include": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts",
    "src/app/globals/utils/tests/RenderWithForm.tsx",
    
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
