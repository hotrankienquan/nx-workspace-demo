{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["dom"],
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ],
    // "rootDir": "src"
    "module": "preserve", // Hoặc "es2022", "nodeNext", hoặc "preserve"
    
    "moduleResolution": "bundler", // Hoặc "nodeNext", "bundler" (nếu bạn muốn dùng 'bundler')
    
    "target": "es2020",
    
    "esModuleInterop": true
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "jest.config.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "setupTests.ts",
    "src/**/**/*.tsx", // include tsx file in src/app/features/....
    "src/**.ts"
  ],
  "files": ["./src/remote-entry2.ts", "./src/remote-entry3.ts"]
}
